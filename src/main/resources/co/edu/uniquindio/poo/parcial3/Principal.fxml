<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="780.0" prefWidth="1200.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial3.viewController.PrincipalViewController">
   <top>
      <VBox spacing="2.0" styleClass="encabezado">
         <children>
            <Label fx:id="lblTituloApp" styleClass="titulo-app" text="Panadería El Trigal" />
            <Label fx:id="lblSubtituloApp" styleClass="subtitulo-app" text="Registre pedidos, asígnelos a producción y recupere el tiempo de los cancelados" />
         </children>
      </VBox>
   </top>
   <center>
      <TabPane fx:id="tabPrincipal" tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab fx:id="tabPedidos" text="Pedidos">
               <content>
                  <fx:include fx:id="vistaPedidos" source="Pedidos.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabEmpleados" text="Empleados">
               <content>
                  <fx:include fx:id="vistaEmpleados" source="Empleados.fxml" />
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
